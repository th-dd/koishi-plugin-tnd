{
  "name": "koishi-plugin-novel-downloader",
  "version": "2.0.1",
  "description": "番茄小说下载器 Koishi 插件（对接 TND 服务）",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "node test/plugin.mjs && node test/local.cjs",
    "test:live": "node test/command.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "koishi",
    "plugin",
    "chatbot",
    "tomato",
    "novel",
    "tnd",
    "小说",
    "番茄小说"
  ],
  "author": "叹号大帝",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th-dd/koishi-plugin-tnd.git"
  },
  "homepage": "https://github.com/th-dd/koishi-plugin-tnd#readme",
  "bugs": {
    "url": "https://github.com/th-dd/koishi-plugin-tnd/issues"
  },
  "peerDependencies": {
    "koishi": "^4.17.0",
    "koishi-plugin-puppeteer": "^3.9.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-puppeteer": {
      "optional": true
    }
  },
  "koishi": {
    "description": {
      "zh": "通过番茄小说下载器 API 实现小说搜索、预览和下载",
      "en": "Search, preview and download novels through the TND service"
    },
    "service": {
      "optional": [
        "puppeteer"
      ]
    }
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "@types/node": "^22.16.0",
    "typescript": "^5.8.0"
  }
}
